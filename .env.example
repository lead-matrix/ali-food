# M/S ALI FOOD - B2B WHOLESALE & SAAS ESTIMATING PLATFORM ENVIRONMENT
# ==============================================================================
# NOTE: The platform is 100% fully functional with NO .env file at all!
# In Local Storage Mode, it uses IndexedDB/localStorage inside the browser.
#
# To activate optional Cloud Mode (Multi-Device Client Logins & Cloud DB):
# 1. Create a Supabase project at https://supabase.com
# 2. Run both SQL files in the SQL Editor:
#    - supabase/schema.sql
#    - supabase/billing_schema.sql
# 3. Supply your Supabase project URL and anon public key below:

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
